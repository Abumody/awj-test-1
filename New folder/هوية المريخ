/* Base background */
body {
  background: #16070D;
}

/* Mars background */
.cosmic-bg {
  background:
    radial-gradient(ellipse at 20% 30%, #5A1020, transparent 60%),
    radial-gradient(ellipse at 80% 70%, #310A17, transparent 50%),
    radial-gradient(ellipse at 50% 50%, #16070D, #050204 100%);
}